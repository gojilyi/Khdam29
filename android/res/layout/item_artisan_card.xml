<?xml version="1.0" encoding="utf-8"?>
<!--
    بطاقة الحرفي في القائمة الأفقية (Item Artisan Card - Material Design 3)
    - حواف دائرية خفيفة (12dp)
    - صورة دائرية للحرفي
    - بدون ظلال مبالغ فيها (Flat Elevation مع إطار صلب ناعم)
    - زر تواصل مباشر بلون الكحلي الصلب
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/khodam_border_subtle"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/khodam_surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="12dp">

        <!-- صورة دائرية للحرفي مع إطار ناعم -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivArtisanAvatar"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/khodam_border_subtle"
            app:strokeWidth="2dp"
            tools:srcCompat="@tools:sample/avatars" />

        <!-- اسم الحرفي -->
        <TextView
            android:id="@+id/tvArtisanName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="المعلم كمال بلقاسم"
            android:textColor="@color/khodam_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- المهنة / التخصص -->
        <TextView
            android:id="@+id/tvArtisanTrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="سباك معتمد وموثق"
            android:textColor="@color/khodam_text_secondary"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- شريط التقييم والنجوم -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="@color/khodam_star_gold" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="4.9"
                android:textColor="@color/khodam_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReviewCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="(142)"
                android:textColor="@color/khodam_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- زر تواصل مباشر بلون كحلي صلب وبدون تدرجات -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDirectContact"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:text="تواصل مباشر"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/khodam_primary_navy"
            app:icon="@android:drawable/ic_menu_call"
            app:iconTint="@color/white"
            app:iconSize="14dp"
            app:iconGravity="textStart"
            app:elevation="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
