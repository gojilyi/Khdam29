rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User Profile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.role in ['client', 'craftsman']
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('wilaya' in data) || (data.wilaya is string && data.wilaya.size() <= 50))
        && (!('commune' in data) || (data.commune is string && data.commune.size() <= 50))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('verification_status' in data) || (data.verification_status in ['pending', 'verified']));
    }

    // Validation for Craftsman Public Profile
    function isValidCraftsmanPublic(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.trade is string && data.trade.size() > 0 && data.trade.size() <= 60
        && (!('experienceYears' in data) || data.experienceYears is number)
        && (!('wilayas' in data) || (data.wilayas is list && data.wilayas.size() <= 58))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000))
        && (!('approximatePriceDzd' in data) || data.approximatePriceDzd is number)
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('portfolioImages' in data) || (data.portfolioImages is list && data.portfolioImages.size() <= 20))
        && (!('isAvailableNow' in data) || data.isAvailableNow is bool);
    }

    // 1. Users Collection (Private Profiles & PII Isolation)
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false; // Blanket lists forbidden to prevent user scraping
      
      // Allow authenticated user to create their document
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Allow owner to update their own document, protecting immutable fields like role
      allow update: if isSignedIn() && request.auth.uid == userId
        && (!('role' in incoming()) || !('role' in existing()) || incoming().role == existing().role);

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. Public Craftsman Directory (Sanitized, public search catalog)
    match /craftsmen_public/{artisanId} {
      allow get: if true;
      allow list: if true;

      allow create: if isOwner(artisanId)
        && isValidId(artisanId)
        && isValidCraftsmanPublic(incoming())
        && incoming().uid == request.auth.uid
        && incoming().verification_status == 'pending';

      allow update: if isOwner(artisanId)
        && isValidId(artisanId)
        && isValidCraftsmanPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().verification_status == existing().verification_status; // verification_status preserved

      allow delete: if isOwner(artisanId);
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.artisanId == request.auth.uid);

      allow list: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.artisanId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(orderId)
        && incoming().clientId == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(orderId)
        && (existing().clientId == request.auth.uid || existing().artisanId == request.auth.uid)
        && incoming().clientId == existing().clientId;

      allow delete: if isSignedIn()
        && existing().clientId == request.auth.uid;
    }
  }
}
